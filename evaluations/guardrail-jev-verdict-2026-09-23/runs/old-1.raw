atures?\\\",{\\\"className\\\":\\\"group rounded-xl border border-white/8 bg-gradient-to-b from-slate-900/40 to-slate-950/60 transition-colors hover:border-purple-500/20\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold text-slate-100 md:text-lg [\\u0026::-webkit-details-marker]:hidden\\\",\\\"children\\\":[\\\"What are the Enterprise-only advanced features?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ml-4 shrink-0 text-purple-400 transition-transform duration-200 group-open:rotate-45\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-6 pb-5 text-sm leading-relaxed text-slate-400 md:text-base\\\",\\\"children\\\":\\\"Enterprise unlocks agent fingerprinting (behavioral verification), in-session monitoring, shadow agent detection, human-in-the-loop (HITL) approvals for high-risk actions, intent-based access control, permission receipts (tamper-evident audit records), and time-limited consent windows.\\\"}]]}]\\n2f:[\\\"$\\\",\\\"details\\\",\\\"Do you offer discounts for startups or open-source projects?\\\",{\\\"className\\\":\\\"group rounded-xl border border-white/8 bg-gradient-to-b from-slate-900/40 to-slate-950/60 transition-colors hover:border-purple-500/20\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold text-slate-100 md:text-lg [\\u0026::-webkit-details-marker]:hidden\\\",\\\"children\\\":[\\\"Do you offer discounts for startups or open-source projects?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ml-4 shrink-0 text-purple-400 transition-transform duration-200 group-open:rotate-45\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-6 pb-5 text-sm leading-relaxed text-slate-400 md:text-base\\\",\\\"children\\\":\\\"Yes. We offer special pricing for early-stage startups, non-profits, and open-source maintainers. Reach out via Slack or email to learn more.\\\"}]]}]\\n\"]) self.__next_f.push([1,\"36:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n\"]) self.__next_f.push([1,\"3e:I[86869,[],\\\"IconMark\\\"]\\n33:null\\n\"]) self.__next_f.push([1,\"38:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Pricing | Permit MCP Gateway\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Transparent pricing for the MCP Gateway. Free for individuals, scalable for teams, enterprise-grade for large organizations.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"alternate\\\",\\\"hrefLang\\\":\\\"en-US\\\",\\\"href\\\":\\\"https://www.permit.io/en-US\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Pricing | Permit MCP Gateway\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Transparent pricing for the MCP Gateway. Free for individuals, scalable for teams, enterprise-grade for large organizations.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://www.permit.io\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Permit.io\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_US\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"property\\\":\\\"og:image:alt\\\",\\\"content\\\":\\\"Permit.io: Runtime Access Control for the AI Era\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:image:type\\\",\\\"content\\\":\\\"image/png\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://www.permit.io/opengraph-image?c7c5d9b2de25f712\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:image:width\\\",\\\"content\\\":\\\"1200\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:image:height\\\",\\\"content\\\":\\\"630\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:creator\\\",\\\"content\\\":\\\"@permit_io\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Pricing | Permit MCP Gateway\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"17\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Transparent pricing for the MCP Gateway. Free for individuals, scalable for teams, enterprise-grade for large organizations.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"18\\\",{\\\"name\\\":\\\"twitter:image:alt\\\",\\\"content\\\":\\\"Permit.io: Runtime Access Control for the AI Era\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"19\\\",{\\\"name\\\":\\\"twitter:image:type\\\",\\\"content\\\":\\\"image/png\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"20\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://www.permit.io/opengraph-image?c7c5d9b2de25f712\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"21\\\",{\\\"name\\\":\\\"twitter:image:width\\\",\\\"content\\\":\\\"1200\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"22\\\",{\\\"name\\\":\\\"twitter:image:height\\\",\\\"content\\\":\\\"630\\\"}],[\\\"$\\\",\\\"link\\\",\\\"23\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico?2753d112d5bcd555\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"32x33\\\"}],[\\\"$\\\",\\\"$L3e\\\",\\\"24\\\",{}]]\\n\"]) ",
