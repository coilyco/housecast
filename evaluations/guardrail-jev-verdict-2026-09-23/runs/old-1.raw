cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold text-slate-100 md:text-lg [\\u0026::-webkit-details-marker]:hidden\\\",\\\"children\\\":[\\\"What authentication methods are supported?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ml-4 shrin\"]) self.__next_f.push([1,\"k-0 text-purple-400 transition-transform duration-200 group-open:rotate-45\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-6 pb-5 text-sm leading-relaxed text-slate-400 md:text-base\\\",\\\"children\\\":\\\"The Consent Service supports email/password, email OTP, passkeys, social providers (Google, GitHub, Microsoft), and enterprise SSO (SAML, OIDC). Admins can configure allowed methods per host, including forced SSO redirect and email-domain restrictions.\\\"}]]}]\\n2d:[\\\"$\\\",\\\"details\\\",\\\"How long do sessions last?\\\",{\\\"className\\\":\\\"group rounded-xl border border-white/8 bg-gradient-to-b from-slate-900/40 to-slate-950/60 transition-colors hover:border-purple-500/20\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold text-slate-100 md:text-lg [\\u0026::-webkit-details-marker]:hidden\\\",\\\"children\\\":[\\\"How long do sessions last?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ml-4 shrink-0 text-purple-400 transition-transform duration-200 group-open:rotate-45\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-6 pb-5 text-sm leading-relaxed text-slate-400 md:text-base\\\",\\\"children\\\":\\\"Application sessions persist across MCP client restarts and are stored in Redis. They have a 30-day inactivity timeout (reset on every tool call) and a 90-day hard maximum. Enterprise plans add fully configurable consent windows. Admins can also revoke sessions immediately.\\\"}]]}]\\n2e:[\\\"$\\\",\\\"details\\\",\\\"What are the Enterprise-only advanced features?\\\",{\\\"className\\\":\\\"group rounded-xl border border-white/8 bg-gradient-to-b from-slate-900/40 to-slate-950/60 transition-colors hover:border-purple-500/20\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold text-slate-100 md:text-lg [\\u0026::-webkit-details-marker]:hidden\\\",\\\"children\\\":[\\\"What are the Enterprise-only advanced features?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ml-4 shrink-0 text-purple-400 transition-transform duration-200 group-open:rotate-45\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-6 pb-5 text-sm leading-relaxed text-slate-400 md:text-base\\\",\\\"children\\\":\\\"Enterprise unlocks agent fingerprinting (behavioral verification), in-session monitoring, shadow agent detection, human-in-the-loop (HITL) approvals for high-risk actions, intent-based access control, permission receipts (tamper-evident audit records), and time-limited consent windows.\\\"}]]}]\\n2f:[\\\"$\\\",\\\"details\\\",\\\"Do you offer discounts for startups or open-source projects?\\\",{\\\"className\\\":\\\"group rounded-xl border border-white/8 bg-gradient-to-b from-slate-900/40 to-slate-950/60 transition-colors hover:border-purple-500/20\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between px-6 py-5 text-base font-semibold text-slate-100 md:text-lg [\\u0026::-webkit-details-marker]:hidden\\\",\\\"children\\\":[\\\"Do you offer discounts for startups or open-source projects?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"ml-4 shrink-0 text-purple-400 transition-transform duration-200 group-open:rotate-45\\\",\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-6 pb-5 text-sm leading-relaxed text-slate-400 md:text-base\\\",\\\"children\\\":\\\"Yes. We offer special pricing 